# Copie para .env (o .env NUNCA vai para o Git) e preencha depois de criar o projeto no Supabase.
# Sem estas duas variáveis o sistema roda em MODO DEMONSTRAÇÃO (dados só neste navegador).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Use somente a chave publicável (anon/publishable). NUNCA coloque a service_role aqui:
# tudo que começa com VITE_ vai para o navegador.
