{
  // Site da Casol Express no Cloudflare (Workers com arquivos estáticos).
  // O nome precisa ser igual ao do projeto no Cloudflare (casolexpress).
  "name": "casolexpress",
  "compatibility_date": "2026-11-18",
  // `wrangler deploy` roda o build do Vite antes de publicar.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // rotas do app (SPA) caem no index.html
    "not_found_handling": "single-page-application"
  }
}
